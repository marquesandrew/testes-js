{
  "name": "api-tarefas",
  "version": "1.2.0",
  "description": "Laboratórios de 08/10 (API), 15/10 (funcional/BDD), 22/10 (E2E com Playwright) e 29/10 (CI e quality gates) - Qualidade de Software 2026/2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ordem": "jest --runInBand --randomize",
    "test:bdd": "cucumber-js",
    "test:tudo": "jest && cucumber-js",
    "start:web": "node src/server-web.js",
    "e2e": "playwright test --project=chromium --project=firefox",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:todos": "playwright test",
    "e2e:ui": "playwright test --project=chromium --ui",
    "e2e:demos": "playwright test -c playwright.demos.config.js",
    "relatorio": "playwright show-report",
    "lint": "eslint .",
    "quality": "node scripts/quality-gate.js",
    "quality:baseline": "jest --coverage --silent && node scripts/quality-gate.js --atualizar-baseline",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/release-check.js",
    "ci": "npm run lint && npm run test:coverage && npm run test:bdd && npm run quality && npm run audit:prod",
    "ci:completo": "npm run ci && npm run e2e:chromium"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.0.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
